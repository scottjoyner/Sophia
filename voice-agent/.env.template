# Sophia Voice Agent — Environment Template
# Copy to .env and fill in your values.  .env is gitignored.
#
# Secrets (set these):
#   SOPHIA_OWNER_OVERRIDE_TOKEN=<your-token>
#   SOPHIA_APP_PASSWORD=<your-password>
#   TOMMY_RELAY_ADMIN_TOKEN=<your-token>
#   SOPHIA_SESSION_SECRET=<your-secret>
#   NEO4J_PASSWORD=<your-neo4j-password>

SOPHIA_VOICE_URL=http://127.0.0.1:8765
ASSISTX_VOICE_WEBHOOK_BASE_URL=http://host.docker.internal:8000
ASSISTX_VOICE_WEBHOOK_SECRET=
VOICE_WEBHOOK_SECRET=
NEO4J_URI=bolt://host.docker.internal:7687
NEO4J_USER=neo4j
NEO4J_PASSWORD=
NEO4J_PASSWORD_FILE=/run/secrets/neo4j_password
NEO4J_DATABASE=neo4j
NEO4J_DEFAULT_SPEAKER=scott
SOPHIA_CAPTURE_DIR=/captures
SOPHIA_INTENT_PROVIDER=mock
SOPHIA_INTENT_BASE_URL=
SOPHIA_INTENT_API_KEY=
SOPHIA_INTENT_MODEL=draft-model
SOPHIA_LLM_PROVIDER=hermes
SOPHIA_LLM_BASE_URL=http://host.docker.internal:8088
SOPHIA_LLM_MODEL=lmstudio-lenovo-ideapad-330s-15ikb.liquid/lfm2.5-1.2b
SOPHIA_TASK_MODEL=lmstudio-lenovo-ideapad-330s-15ikb.liquid/lfm2.5-1.2b
SOPHIA_LLM_TIMEOUT=90
SOPHIA_TASK_TIMEOUT=150
SOPHIA_FLEET_DISCOVERY=true
SOPHIA_FLEET_NODE_PORT=1234
SOPHIA_FLEET_REFRESH_INTERVAL=30
SOPHIA_FLEET_CHAT_MAX_PARAMS=4
SOPHIA_FLEET_TASK_MIN_PARAMS=20
SOPHIA_OWNER_OVERRIDE_ENABLED=true
TORCH_HUB_TRUSTED_REPOS=snakers4/silero-vad
COQUI_TOS_AGREED=1

# Secrets — set these via Docker secrets or host environment.
# SOPHIA_OWNER_OVERRIDE_TOKEN=
# SOPHIA_APP_PASSWORD=
# TOMMY_RELAY_ADMIN_TOKEN=
# SOPHIA_SESSION_SECRET=
# NEO4J_PASSWORD=